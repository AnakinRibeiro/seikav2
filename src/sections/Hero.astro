---
/**
 * Hero (Figma: "Hero — foto full-bleed + card de avaliação em vidro").
 * Desktop 860px de altura, texto e card lado a lado; tablet 1024px, empilhado;
 * mobile com altura do conteúdo e botões em largura total.
 * Entrada animada (GSAP, script no fim): a foto se revela de baixo para cima, o título sobe linha
 * por linha de trás de uma máscara, o resto aparece quase junto e, por último, o card e seus itens.
 * Os atributos `data-hero*` marcam o que anima; sem JavaScript ou com `prefers-reduced-motion`
 * (classe `anim` ausente em <html>) nada fica escondido.
 */
import { Picture } from 'astro:assets';
import heroImage from '../assets/images/hero.png';
import Badge from '../components/Badge/Badge.astro';
import Button from '../components/Button/Button.astro';
import Icon from '../components/Icon/Icon.astro';
import Rating from '../components/Rating/Rating.astro';
import SiteNav from '../components/SiteNav/SiteNav.astro';
import { whatsapp } from '../config/site';
---

<section
  id="inicio"
  class="relative isolate flex flex-col items-center gap-20 pt-6 pb-10 tablet:min-h-256 tablet:justify-between tablet:pb-12 desktop:min-h-215 desktop:gap-0 desktop:pb-16"
>
  <div aria-hidden="true" data-hero-bg class="absolute inset-0 -z-10">
    <Picture
      src={heroImage}
      alt=""
      formats={['avif', 'webp']}
      quality="high"
      widths={[640, 960, 1195]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="size-full object-cover"
    />
    <div class="hero-overlay absolute inset-0"></div>
  </div>

  <div data-hero class="w-full">
    <SiteNav />
  </div>

  <div class="container-page flex flex-col gap-8 tablet:gap-10 desktop:flex-row desktop:items-end desktop:justify-between">
    <div class="flex flex-col gap-8 desktop:w-164">
      <div class="flex flex-col gap-6">
        <div class="flex flex-col items-start gap-4">
          <div data-hero>
            <Badge
              text="Responsável técnico: Eng. Adriano J. Gorges · CREA-PR 206130/D"
              icon="shield"
            />
          </div>
          <h1
            data-hero-title
            class="text-h4 text-text-inverse-emphasis tablet:text-h3 desktop:text-h1"
          >
            {/* Lines are explicit spans (masks for the intro): "…elétrica / e energia solar" from tablet up, "…elétrica e / energia solar" on mobile. */}
            <span class="-mb-[0.1em] block overflow-clip pb-[0.1em]">
              <span data-hero-line class="block">
                Engenharia elétrica<span class="tablet:hidden">{' e'}</span>
              </span>
            </span>{' '}
            <span class="-mb-[0.1em] block overflow-clip pb-[0.1em]">
              <span data-hero-line class="block">
                <span class="hidden tablet:inline">{'e '}</span>
                <span class="text-(--primitive-yellow-500)">energia solar</span>
              </span>
            </span>
          </h1>
        </div>
        <p
          data-hero
          class="text-body-base text-text-inverse/85 tablet:text-body-large-regular desktop:w-130"
        >
          Soluções completas em engenharia elétrica e energia solar para residências e empresas.
        </p>
      </div>

      <div data-hero class="flex flex-col gap-3 tablet:flex-row">
        <Button
          text="Simular minha economia"
          href={whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full tablet:w-auto"
        />
        <Button
          text="Ver todos os serviços"
          variant="secondary-inverse"
          icon={false}
          href="#servicos"
          class="w-full tablet:w-auto"
        />
      </div>
    </div>

    <figure
      data-hero-card
      class="flex flex-col gap-4 rounded-container bg-bg-inverse/40 p-6 inset-ring inset-ring-border-inverse/20 backdrop-blur-[7px] desktop:w-92"
    >
      <div data-hero-item>
        <Rating size="P" />
      </div>
      <blockquote data-hero-item class="text-body-base-medium text-text-inverse">
        <p>
          “Precisávamos de previsibilidade de custo. Fizeram o estudo, cuidaram da homologação e
          ainda ajustaram o cronograma para não parar a produção.”
        </p>
      </blockquote>
      <figcaption
        data-hero-item
        class="flex flex-col gap-2 tablet:flex-row tablet:items-center tablet:justify-between"
      >
        <span class="text-body-small text-text-inverse/75">Marcos · Cliente comercial</span>
        <a
          href="#depoimentos"
          class="inline-flex items-center gap-1 text-body-small-semibold text-(--primitive-yellow-300) hover:underline"
        >
          Ver depoimentos
          <Icon name="arrow-right" size={16} />
        </a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /*
   * Initial state of the intro, only while `anim` is on <html> (set in Layout when motion is allowed).
   * Fail-safe: if the script never runs, everything shows after 3s.
   */
  :global(.anim) [data-hero],
  :global(.anim) [data-hero-title],
  :global(.anim) [data-hero-card] {
    visibility: hidden;
    animation: hero-show 0s 3s forwards;
  }
  :global(.anim) [data-hero-bg] {
    clip-path: inset(100% 0 0 0);
    animation: hero-bg-show 0s 3s forwards;
  }
  @keyframes hero-show {
    to {
      visibility: visible;
    }
  }
  @keyframes hero-bg-show {
    to {
      clip-path: inset(0);
    }
  }

  /* Figma overlay: navy at 67% → 0% → 15% → 98%, top to bottom. */
  .hero-overlay {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg-inverse) 67%, transparent) 2.44%,
      color-mix(in srgb, var(--color-bg-inverse) 0%, transparent) 26.38%,
      color-mix(in srgb, var(--color-bg-inverse) 15%, transparent) 52.28%,
      color-mix(in srgb, var(--color-bg-inverse) 98%, transparent) 100%
    );
  }
</style>

<script>
  import { gsap } from 'gsap';

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('#inicio');

  if (hero && root.classList.contains('anim')) {
    const q = (selector: string) => hero.querySelectorAll<HTMLElement>(selector);
    const bg = hero.querySelector<HTMLElement>('[data-hero-bg]')!;
    const title = hero.querySelector<HTMLElement>('[data-hero-title]')!;
    const items = q('[data-hero]');
    const card = hero.querySelector<HTMLElement>('[data-hero-card]')!;
    const cardItems = q('[data-hero-item]');

    gsap.set(cardItems, { autoAlpha: 0, y: 14 });

    const play = () => {
      // Photo opens from the bottom up while it settles from a slight zoom.
      gsap.to(bg, {
        clipPath: 'inset(0% 0 0 0)',
        duration: 0.9,
        ease: 'power3.out',
      });
      gsap.fromTo(
        bg.querySelector('img'),
        { scale: 1.12 },
        { scale: 1, duration: 1.8, ease: 'power2.out', clearProps: 'transform' },
      );

      // Title rises line by line from behind a mask (the lines are overflow-clip wrappers).
      gsap.set(title, { autoAlpha: 1 });
      gsap.fromTo(
        q('[data-hero-line]'),
        { yPercent: 110 },
        { yPercent: 0, duration: 0.9, ease: 'power4.out', stagger: 0.12, delay: 0.15 },
      );

      // Menu, badge, text and buttons arrive almost together.
      gsap.fromTo(
        items,
        { autoAlpha: 0, y: 18 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          stagger: 0.07,
          delay: 0.3,
          clearProps: 'transform',
        },
      );

      // Glass card last, then its content in sequence.
      gsap
        .timeline({ delay: 0.8 })
        .fromTo(
          card,
          { autoAlpha: 0, y: 24 },
          { autoAlpha: 1, y: 0, duration: 0.8, ease: 'power3.out', clearProps: 'transform' },
        )
        .to(
          cardItems,
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.6,
            ease: 'power3.out',
            stagger: 0.12,
            clearProps: 'transform',
          },
          '-=0.45',
        );
    };

    play();
  }
</script>
