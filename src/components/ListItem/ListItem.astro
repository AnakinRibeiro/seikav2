---
/**
 * Item de lista com ícone (Figma: Item de lista), usado na seção Quem somos.
 * Ícone 20px em icon/accent + texto body/base em text/primary, gap 12. Renderiza um <li>.
 */
import Icon, { type IconName } from '../Icon/Icon.astro';

export interface Props {
  text: string;
  icon?: IconName;
  class?: string;
}

const { text, icon = 'zap', class: className } = Astro.props;
---

<li class:list={['flex items-center gap-3 text-body-base text-text-primary', className]}>
  <Icon name={icon} size={20} class="shrink-0 text-icon-accent" />
  {text}
</li>
